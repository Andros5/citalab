# Copia este fichero como .env y añade tus claves. El fichero .env no se versiona.
# Solo hacen falta para conversar con el asistente o repetir la campaña.
GROQ_API_KEY=
GEMINI_API_KEY=

# Modelos de la campaña final (son los valores por defecto).
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-3.5-flash-lite
SIMULATOR_MODEL=qwen/qwen3.8-27b

# Límites de cada llamada.
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=1200
