    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.13.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.2",
